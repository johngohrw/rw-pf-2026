---
import { HeroText } from "@components/HeroText";
import { Brand } from "../components/Brand";
import { ReactComponent } from "../components/ReactComponent";
import Layout from "../layouts/Layout.astro";
import ContactSection from "@components/ContactSection.astro";
import MediaBoxes from "@components/MediaBoxes.astro";
import ScrollSmootherWrapper from "@components/ScrollSmootherWrapper.astro";
import LoopingLogos from "@components/LoopingLogos";
import LoopingLogoSection from "@components/LoopingLogoSection.astro";
---

<Layout>
  <div class="overlay" style={{ top: 0 }}>
    <div class="overlay-content">
      <Brand client:only />
    </div>
  </div>
  <div class="overlay" style={{ bottom: 0 }}>
    <div class="overlay-content">
      <HeroText client:only />
    </div>
  </div>
  <div style={{ zIndex: 0 }}>
    <ScrollSmootherWrapper>
      <div class="frame">
        <div style={{ position: "relative", height: "70%", top: "12.5%" }}>
          <MediaBoxes />
        </div>
      </div>
      <LoopingLogoSection />
      <ContactSection />
    </ScrollSmootherWrapper>
  </div>
</Layout>
<style>
  .overlay {
    position: fixed;
    width: 100svw;
    height: 100svh;
    z-index: 100;
    mix-blend-mode: exclusion;
    pointer-events: none;
    color: rgb(233, 227, 227);
  }
  .overlay-content {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .frame {
    height: 100vh;
    width: 100vw;
    position: relative;
    z-index: 1;
  }
</style>
